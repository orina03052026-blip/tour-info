# ========================================
# Instagram Story Auto-Posting Configuration
# ========================================
# このファイルをコピーして .env を作成し、
# 実際の値を入力してください
# 
# 本ファイルはレポジトリに含めてOK（秘密情報は含まない）
# .env は .gitignore に追加して、リポジトリに含めないでください
# ========================================

# ========================================
# Google Spreadsheet Configuration
# ========================================
# Google Sheets のID
# URL: https://docs.google.com/spreadsheets/d/{GOOGLE_SHEET_ID}/edit
GOOGLE_SHEET_ID=1Lyl_tjTHza8Wfp2WiDepi_ZTY_Xo6Xqpuhgog-lufFY

# シートのGID（デフォルト 0 = 最初のシート）
GOOGLE_SHEET_GID=0

# ========================================
# WordPress Configuration
# ========================================
# WordPress サイトのURL（最後のスラッシュなし）
WORDPRESS_URL=https://www.travel-network-act.co.jp

# REST API 用ユーザー名
# WordPress管理画面 > ユーザー > 新規追加で作成してください
WORDPRESS_USERNAME=instagram_bot

# REST API 用アプリケーションパスワード
# WordPress管理画面 > ユーザー > 編集 > アプリケーションパスワード で生成
# 形式: xxxx xxxx xxxx xxxx xxxx xxxx（スペース含む）
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ========================================
# Instagram Configuration
# ========================================
# Instagram Business Account ID
# Meta Business Suite で確認できます
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400963662003

# Instagram Graph API Long-lived Access Token
# Meta Developers で生成してください
# 有効期限: 60日間（更新手順は README参照）
INSTAGRAM_ACCESS_TOKEN=IGBBQx...（長いトークン）...xyz

# Facebook Page ID（Instagram と連携しているページ）
# Meta Business Suite で確認できます
FACEBOOK_PAGE_ID=12345678901234567

# ========================================
# QR Code Configuration
# ========================================
# QRコードのリンク先URL
QR_CODE_URL=https://www.travel-network-act.co.jp/local/en/we-still-have-spots-available-for-our-tours-and-etc/

# ========================================
# Logging Configuration
# ========================================
# ログレベル: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ========================================
# Scheduling (GitHub Actions 環境変数)
# ========================================
# GitHub Actions では、以下の設定で毎日0:00JST に実行します
# ワークフロー定義ファイルを参照してください
# .github/workflows/instagram-story-daily.yml
